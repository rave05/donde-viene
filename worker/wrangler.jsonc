{
  "name": "donde-viene-servicios",
  "main": "index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CACHE_PUBLIC_TRANSIT": "true",
    "APP_ORIGIN": "https://rave05.github.io",
    "AVISOS_URL": "https://rave05.github.io/donde-viene/datos/avisos-oficiales.json",
    "VAPID_SUBJECT": "mailto:dondevieneadvertisement@gmail.com",
  },
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "services": [{ "binding": "TRANSPORTE", "service": "donde-viene-api" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donde-viene-servicios",
      "database_id": "3548d5e8-ed3b-4a62-acb0-0441c914857c",
    },
  ],
  // Inicializar las tablas con schema.sql antes de activar el servicio en la app.
  // Claves VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY y ADMIN_TOKEN mediante wrangler secret.
  // TRANSPORTE es opcional: service binding al Worker original para probar la caché sin reemplazarlo.
}
